{
  "//": "Own config instead of @docusaurus/tsconfig: that one enables allowJs and the TS 6-deprecated baseUrl.",
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "jsx": "preserve",
    "types": ["node", "@docusaurus/module-type-aliases"],
    "noEmit": true,
    "declaration": false,
    "paths": {
      "@site/*": ["./*"]
    }
  },
  "include": ["docusaurus.config.ts", "sidebars.ts", "src"]
}
