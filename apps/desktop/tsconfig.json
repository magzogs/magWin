{
  "//": "Editor/ESLint view of the whole app. Strict per-process checks live in tsconfig.node.json and tsconfig.web.json.",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "electron-vite/node", "vite/client"],
