{
  "name": "magwin",
  "private": true,
  "version": "0.1.0",
  "description": "macOS window grid snapping and Desktop-aware layout snapshots (Electron + Swift helper)",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "node apps/desktop/node_modules/electron/install.js",
    "build:helper": "swift build -c release --package-path native/MagWinHelper",
    "test:helper": "swift test --package-path native/MagWinHelper",
    "dev": "pnpm build:helper && pnpm --filter @magwin/desktop dev",
    "dev:docs": "pnpm --filter @magwin/docs start",
    "build": "pnpm build:helper && pnpm --filter @magwin/desktop build",
    "build:docs": "pnpm --filter @magwin/docs build",
    "package": "pnpm build && pnpm --filter @magwin/desktop package",
    "release": "APPLE_KEYCHAIN_PROFILE=orgawin-notary pnpm package",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.tooling.json --noEmit && pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm test:helper"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jiti": "2.7.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "vite": "7.3.6"
    },
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
